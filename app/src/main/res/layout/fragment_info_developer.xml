<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <include
        android:id="@+id/toolbar_include"
        layout="@layout/toolbar_simple"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_include"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name" android:textSize="20sp" android:textStyle="bold"
                android:textColor="@color/navy_900"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Versi 1.0.0" android:textSize="13sp" android:textColor="@color/on_surface_muted"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginVertical="20dp" android:background="@color/divider"/>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Dikembangkan oleh" android:textStyle="bold" android:textColor="@color/navy_900"
                android:gravity="start"/>

            <TextView
                android:id="@+id/text_nama_dev"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Nugroho Y.R."
                android:textSize="15sp" android:textColor="@color/on_surface" android:gravity="start"/>

            <TextView
                android:id="@+id/text_github"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="GitHub: computerid-dev"
                android:textSize="13sp" android:textColor="@color/on_surface_muted" android:gravity="start"/>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Study Mate adalah aplikasi pendamping belajar untuk membantu pelajar mengelola pelajaran, tugas, jadwal, materi, ujian, dan keuangan sekolah dalam satu tempat, cepat dan bisa dipakai offline."
                android:textColor="@color/on_surface_muted" android:lineSpacingExtra="4dp" android:gravity="start"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="520dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pelajaran" android:textColor="@color/on_surface_muted" android:textSize="12sp"/>
        <Spinner android:id="@+id/spinner_pelajaran" android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_card_soft" android:paddingHorizontal="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Hari" android:textColor="@color/on_surface_muted" android:textSize="12sp"/>
        <Spinner android:id="@+id/spinner_hari" android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_card_soft" android:paddingHorizontal="12dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.StudyMate.InputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:hint="Jam Mulai (contoh 07.00)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_jam_mulai" android:focusable="false" android:cursorVisible="false"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.StudyMate.InputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="Jam Selesai (contoh 08.30)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_jam_selesai" android:focusable="false" android:cursorVisible="false"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.StudyMate.InputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="Catatan (opsional)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_catatan" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minLines="2" android:gravity="top"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
